2610" y="20" width="260" height="30" as="geometry"/></mxCell><mxCell id="c48" value="T4.1&lt;br&gt;Calcula a ojo lo que sobró de cada producto" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0E3A5B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2610" y="375" width="130" height="70" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;rounded=0;" edge="1" parent="1" source="c43" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="T4.2&lt;br&gt;Guarda en frío lo que pasa al día siguiente" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0E3A5B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2780" y="375" width="130" height="70" as="geometry"/></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;rounded=0;" edge="1" parent="1" source="c48" target="c50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="T4.3&lt;br&gt;Separa lo que se remata o se lleva a casa" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0E3A5B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2950" y="375" width="130" height="70" as="geometry"/></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;rounded=0;" edge="1" parent="1" source="c50" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c54" value="T4.4&lt;br&gt;Paga los gastos del día sin anotarlos" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0E3A5B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3120" y="375" width="130" height="70" as="geometry"/></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;rounded=0;" edge="1" parent="1" source="c52" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c56" value="Sin registro (memoria)" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF7E0;fontSize=9;" vertex="1" parent="1"><mxGeometry x="3140" y="457" width="90" height="40" as="geometry"/></mxCell><mxCell id="c57" value="" style="dashed=1;endArrow=none;html=1;" edge="1" parent="1" source="c54" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="A5 · Cuadrar el día" style="text;html=1;fontStyle=1;fontColor=#0E3A5B;align=left;" vertex="1" parent="1"><mxGeometry x="3290" y="20" width="260" height="30" as="geometry"/></mxCell><mxCell id="c59" value="T5.1&lt;br&gt;Pasa a limpio los borradores al cuaderno" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0E3A5B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3290" y="515" width="130" height="70" as="geometry"/></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;rounded=0;" edge="1" parent="1" source="c54" target="c59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c61" value="T5.2&lt;br&gt;Cuenta el efectivo y revisa los Yape del día" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0E3A5B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3460" y="515" width="130" height="70" as="geometry"/></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;rounded=0;" edge="1" parent="1" source="c59" target="c61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="T5.3&lt;br&gt;Suma las ventas del día en el cuaderno" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0E3A5B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3630" y="515" width="130" height="70" as="geometry"/></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;rounded=0;" edge="1" parent="1" source="c61" target="c63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c65" value="T5.4&lt;br&gt;Estima la ganancia restando lo que recuerda de las compras" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0E3A5B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3800" y="515" widt