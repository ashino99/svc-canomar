digraph ER { rankdir=LR; nodesep=0.3; ranksep=0.7; splines=true;
node [shape=plaintext, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#455A64", dir=both, arrowtail=teetee, arrowhead=crow, arrowsize=1.0];
usuario [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3864"><font color="white"><b>USUARIO</b></font></td></tr><tr><td align="left" port="id_usuario"><font point-size="9">PK</font></td><td align="left"><u>id_usuario</u></td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="nombre_completo"><font point-size="9"> </font></td><td align="left">nombre_completo</td><td align="left"><font point-size="9" color="#616161">VARCHAR(100)</font></td></tr><tr><td align="left" port="usuario"><font point-size="9"> </font></td><td align="left">usuario</td><td align="left"><font point-size="9" color="#616161">VARCHAR(30)</font></td></tr><tr><td align="left" port="clave_hash"><font point-size="9"> </font></td><td align="left">clave_hash</td><td align="left"><font point-size="9" color="#616161">VARCHAR(255)</font></td></tr><tr><td align="left" port="rol"><font point-size="9"> </font></td><td align="left">rol</td><td align="left"><font point-size="9" color="#616161">ENUM</font></td></tr><tr><td align="left" port="estado"><font point-size="9"> </font></td><td align="left">estado</td><td align="left"><font point-size="9" color="#616161">ENUM</font></td></tr><tr><td align="left" port="intentos_fallidos"><font point-size="9"> </font></td><td align="left">intentos_fallidos</td><td align="left"><font point-size="9" color="#616161">TINYINT</font></td></tr><tr><td align="left" port="bloqueado_hasta"><font point-size="9"> </font></td><td align="left">bloqueado_hasta</td><td align="left"><font point-size="9" color="#616161">DATETIME</font></td></tr><tr><td align="left" port="fecha_registro"><font point-size="9"> </font></td><td align="left">fecha_registro</td><td align="left"><font point-size="9" color="#616161">DATETIME</font></td></tr></table>>];
proveedor [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3864"><font color="white"><b>PROVEEDOR</b></font></td></tr><tr><td align="left" port="id_proveedor"><font point-size="9">PK</font></td><td align="left"><u>id_proveedor</u></td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="nombre"><font point-size="9"> </font></td><td align="left">nombre</td><td align="left"><font point-size="9" color="#616161">VARCHAR(100)</font></td></tr><tr><td align="left" port="ruc"><font point-size="9"> </font></td><td align="left">ruc</td><td align="left"><font point-size="9" color="#616161">CHAR(11)</font></td></tr><tr><td align="left" port="tipo"><font point-size="9"> </font></td><td align="left">tipo</td><td align="left"><font point-size="9" color="#616161">ENUM</font></td></tr><tr><td align="left" port="telefono"><font point-size="9"> </font></td><td align="left">telefono</td><td align="left"><font point-size="9" color="#616161">VARCHAR(15)</font></td></tr></table>>];
compra [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3864"><font color="white"><b>COMPRA</b></font></td></tr><tr><td align="left" port="id_compra"><font point-size="9">PK</font></td><td align="left"><u>id_compra</u></td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="id_proveedor"><font point-size="9">FK</font></td><td align="left">id_proveedor #</td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="id_usuario"><font point-size="9">FK</font></td><td align="left">id_usuario #</td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="fecha"><font point-size="9"> </font></td><td align="left">fecha</td><td align="left"><font point-size="9" color="#616161">DATE</font></td></tr><tr><td align="left" port="tipo_pago"><font point-size="9"> </font></td><td align="left">tipo_pago</td><td align="left"><font point-size="9" color="#616161">ENUM</font></td></tr><tr><td align="left" port="estado"><font point-size="9"> </font></td><td align="left">estado</td><td align="left"><font point-size="9" color="#616161">ENUM</font></td></tr></table>>];
detalle_compra [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3864"><font color="white"><b>DETALLE_COMPRA</b></font></td></tr><tr><td align="left" port="id_detalle_compra"><font point-size="9">PK</font></td><td align="left"><u>id_detalle_compra</u></td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="id_compra"><font point-size="9">FK</font></td><td align="left">id_compra #</td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="id_producto"><font point-size="9">FK</font></td><td align="left">id_producto #</td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="kilos"><font point-size="9"> </font></td><td align="left">kilos</td><td align="left"><font point-size="9" color="#616161">DECIMAL(8,2)</font></td></tr><tr><td align="left" port="costo_total"><font point-size="9"> </font></td><td align="left">costo_total</td><td align="left"><font point-size="9" color="#616161">DECIMAL(10,2)</font></td></tr></table>>];
pago_proveedor [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3864"><font color="white"><b>PAGO_PROVEEDOR</b></font></td></tr><tr><td align="left" port="id_pago"><font point-size="9">PK</font></td><td align="left"><u>id_pago</u></td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="id_proveedor"><font point-size="9">FK</font></td><td align="left">id_proveedor #</td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="id_usuario"><font point-size="9">FK</font></td><td align="left">id_usuario #</td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="fecha"><font point-size="9"> </font></td><td align="left">fecha</td><td align="left"><font point-size="9" color="#616161">DATE</font></td></tr><tr><td align="left" port="monto"><font point-size="9"> </font></td><td align="left">monto</td><td align="left"><font point-size="9" color="#616161">DECIMAL(10,2)</font></td></tr><tr><td align="left" port="medio"><font point-size="9"> </font></td><td align="left">medio</td><td align="left"><font point-size="9" color="#616161">ENUM</font></td></tr></table>>];
producto [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3864"><font color="white"><b>PRODUCTO</b></font></td></tr><tr><td align="left" port="id_producto"><font point-size="9">PK</font></td><td align="left"><u>id_producto</u></td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="nombre"><font point-size="9"> </font></td><td align="left">nombre</td><td align="left"><font point-size="9" color="#616161">VARCHAR(60)</font></td></tr><tr><td align="left" port="nombre_corto"><font point-size="9"> </font></td><td align="left">nombre_corto</td><td align="left"><font point-size="9" color="#616161">VARCHAR(20)</font></td></tr><tr><td align="left" port="categoria"><font point-size="9"> </font></td><td align="left">categoria</td><td align="left"><font point-size="9" color="#616161">ENUM</font></td></tr><tr><td align="left" port="estado"><font point-size="9"> </font></td><td align="left">estado</td><td align="left"><font point-size="9" color="#616161">ENUM</font></td></tr></table>>];
precio_dia [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3864"><font color="white"><b>PRECIO_DIA</b></font></td></tr><tr><td align="left" port="id_precio"><font point-size="9">PK</font></td><td align="left"><u>id_precio</u></td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="id_producto"><font point-size="9">FK</font></td><td align="left">id_producto #</td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="fecha"><font point-size="9"> </font></td><td align="left">fecha</td><td align="left"><font point-size="9" color="#616161">DATE</font></td></tr><tr><td align="left" port="precio_kg"><font point-size="9"> </font></td><td align="left">precio_kg</td><td align="left"><font point-size="9" color="#616161">DECIMAL(8,2)</font></td></tr><tr><td align="left" port="costo_promedio_kg"><font point-size="9"> </font></td><td align="left">costo_promedio_kg</td><td align="left"><font point-size="9" color="#616161">DECIMAL(8,2)</font></td></tr></table>>];
lote_saldo [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3864"><font color="white"><b>LOTE_SALDO</b></font></td></tr><tr><td align="left" port="id_lote"><font point-size="9">PK</font></td><td align="left"><u>id_lote</u></td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="id_producto"><font point-size="9">FK</font></td><td align="left">id_producto #</td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="id_detalle_compra"><font point-size="9">FK</font></td><td align="left">id_detalle_compra #</td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="fecha_ingreso"><font point-size="9"> </font></td><td align="left">fecha_ingreso</td><td align="left"><font point-size="9" color="#616161">DATE</font></td></tr><tr><td align="left" port="kilos_disponibles"><font point-size="9"> </font></td><td align="left">kilos_disponibles</td><td align="left"><font point-size="9" color="#616161">DECIMAL(8,2)</font></td></tr><tr><td align="left" port="costo_kg"><font point-size="9"> </font></td><td align="left">costo_kg</td><td align="left"><font point-size="9" color="#616161">DECIMAL(8,2)</font></td></tr></table>>];
ajuste_saldo [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3864"><font color="white"><b>AJUSTE_SALDO</b></font></td></tr><tr><td align="left" port="id_ajuste"><font point-size="9">PK</font></td><td align="left"><u>id_ajuste</u></td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="id_lote"><font point-size="9">FK</font></td><td align="left">id_lote #</td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="id_usuario"><font point-size="9">FK</font></td><td align="left">id_usuario #</td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="fecha"><font point-size="9"> </font></td><td align="left">fecha</td><td align="left"><font point-size="9" color="#616161">DATETIME</font></td></tr><tr><td align="left" port="tipo"><font point-size="9"> </font></td><td align="left">tipo</td><td align="left"><font point-size="9" color="#616161">ENUM</font></td></tr><tr><td align="left" port="kilos"><font point-size="9"> </font></td><td align="left">kilos</td><td align="left"><font point-size="9" color="#616161">DECIMAL(8,2)</font></td></tr><tr><td align="left" port="valor_costo"><font point-size="9"> </font></td><td align="left">valor_costo</td><td align="left"><font point-size="9" color="#616161">DECIMAL(10,2)</font></td></tr><tr><td align="left" port="motivo"><font point-size="9"> </font></td><td align="left">motivo</td><td align="left"><font point-size="9" color="#616161">VARCHAR(150)</font></td></tr></table>>];
configuracion [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3864"><font color="white"><b>CONFIGURACION</b></font></td></tr><tr><td align="left" port="id_configuracion"><font point-size="9">PK</font></td><td align="left"><u>id_configuracion</u></td><td align="left"><font point-size="9" color="#616161">INT</font></td></tr><tr><td align="left" port="dias_alerta_saldo"><font point-size="9"> </font></td><td align="left">dias_alerta_saldo</td><td align="left"><font point-size="9" color="#616161">TINYINT</font></td></tr><tr><td align="left" port="tolerancia_consumo"><font point-size="9"> </font></td><td align="left">tolerancia_consumo</td><td align="left"><font point-size="9" color="#616161">DECIMAL(4,2)</font></td></tr><tr><td align="left" port="tolerancia_cuadre"><font point-size="9"> </font></td><td align="left">tolerancia_cuadre</td><td align="left"><font point-size="9" color="#616161">DECIMAL(6,2)</font></td></tr></table>>];
usuario -> compra [arrowtail=teetee, arrowhead=crowodot, label="registra"];
proveedor -> compra [arrowtail=teetee, arrowhead=crowodot, label="vende"];
compra -> detalle_compra [arrowtail=teetee, arrowhead=crowodot, label="contiene"];
producto -> detalle_compra [arrowtail=teetee, arrowhead=crowodot, label="es comprado"];
proveedor -> pago_proveedor [arrowtail=teetee, arrowhead=crowodot, label="recibe"];
usuario -> pago_proveedor [arrowtail=teetee, arrowhead=crowodot, label="registra"];
producto -> precio_dia [arrowtail=teetee, arrowhead=crowodot, label="tiene"];
producto -> lote_saldo [arrowtail=teetee, arrowhead=crowodot, label="tiene"];
detalle_compra -> lote_saldo [arrowtail=teeodot, arrowhead=teetee, label="origina"];
